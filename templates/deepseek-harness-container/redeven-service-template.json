  "developer_preview": true,
  "disk_bytes": 2147483648,
  "source_url": "https://github.com/deepseek-ai/deepseek-harness",
  "docker_source_url": "https://github.com/runzhliu/deepseek-harness-docker",
  "deployment": "container",
  "container_mode": "single",
  "default_access_mode": "desktop_loopback",
  "platform_artifacts": {"linux-amd64":"ghcr.io/runzhliu/deepseek-harness:0.2.1-alpha.3-r1-ungoogled.1@sha256:a8ad17c636ea3c077c5e1d4c4a1389e36ede102a86047bea0ebd00cc9832b747","linux-arm64":"ghcr.io/runzhliu/deepseek-harness:0.2.1-alpha.3-r1-ungoogled.1@sha256:c916d5d0cfaa3aa3be3406359645272fbac573b9375e60439a9bd6a4f966e585"},
  "release_discovery": {
    "source": "oci"
  },
  "notices": [
    {
      "id": "community-container-image",
      "revision": 1,
      "severity": "warning",
      "acknowledgement_required": false
    },
    {
      "id": "service-api-credentials",
      "revision": 1,
      "severity": "info",
      "acknowledgement_required": false
    }
  ],
  "icon": {
    "path": "assets/icon.svg",
    "media_type": "image/svg+xml"
  },
  "spec": {
    "schema_version": 7,
    "kind": "container",
    "endpoint": {
      "scheme": "http",
      "container_port": 3080,
      "health_path": "/",
      "startup_timeout_sec": 45
    },
    "startup_url": {"line_prefix": "dsh web: "},
    "container": {
      "image": "${REDEVEN_CATALOG_ARTIFACT}",
      "environment": {
        "DSH_DESKTOP_ENABLED": "0",
        "DSH_HOME": "/home/node/.dsh",
        "HOME": "/workspace"
      },
      "mounts": [
        {
          "resource_id": "data",
          "type": "volume",
          "source": "data",
          "target": "/home/node/.dsh"
        },
        {
          "resource_id": "workspace",
          "type": "workspace",
          "target": "/workspace"
        },
        {
          "resource_id": "tmp",
          "type": "tmpfs",
          "target": "/tmp"
        }
      ],
      "user": "1000:1000",
      "read_only_root": true,
      "pids_limit": 512
    }
  },
  "kind": "redeven.service-template",
  "default_locale": "en-US",
  "locales": [
    "en-US",
    "zh-CN",
    "zh-TW",
    "ja-JP",
    "ko-KR",
    "de-DE",
    "fr-FR",
    "es-ES",
    "pt-BR",
    "ru-RU"
  ]
}
