  "notices": [
    {
      "id": "community-container-image",
      "revision": 1,
      "severity": "warning",
      "acknowledgement_required": false
    },
    {
      "id": "service-api-credentials",
      "revision": 1,
      "severity": "info",
      "acknowledgement_required": false
    }
  ],
  "icon": {
    "path": "assets/icon.svg",
    "media_type": "image/svg+xml"
  },
  "spec": {
    "schema_version": 6,
    "kind": "container",
    "endpoint": {
      "scheme": "http",
      "container_port": 3080,
      "path": "/",
      "health_path": "/",
      "startup_timeout_sec": 45
    },
    "container": {
      "image": "${REDEVEN_CATALOG_ARTIFACT}",
      "environment": {
        "DSH_DESKTOP_ENABLED": "0",
        "DSH_HOME": "/home/node/.dsh",
        "HOME": "/workspace"
      },
      "mounts": [
        {
          "resource_id": "data",
          "type": "volume",
          "source": "data",
          "target": "/home/node/.dsh"
        },
        {
          "resource_id": "workspace",
          "type": "workspace",
          "target": "/workspace"
        },
        {
          "resource_id": "tmp",
          "type": "tmpfs",
          "target": "/tmp"
        }
      ],
      "user": "1000:1000",
      "read_only_root": true,
      "pids_limit": 512
    }
  },
  "kind": "redeven.service-template",
  "default_locale": "en-US",
  "locales": [
    "en-US",
    "zh-CN",
    "zh-TW",
    "ja-JP",
    "ko-KR",
    "de-DE",
    "fr-FR",
    "es-ES",
    "pt-BR",
