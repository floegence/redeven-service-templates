  "default_access_mode": "desktop_loopback",
  "platform_artifacts": {"linux-amd64":"ghcr.io/runzhliu/deepseek-harness:0.1.5-rc.2-r1-ungoogled.1@sha256:f198fcf2b99f8523c0a8be3bafba4a1b22acf40657bf20ca93abd66df3f29aa9","linux-arm64":"ghcr.io/runzhliu/deepseek-harness:0.1.5-rc.2-r1-ungoogled.1@sha256:51f8fcda310b7be46fde15bd9d94f6393389c2ece228c902fd26e27e62c40322"},
  "release_discovery": {
