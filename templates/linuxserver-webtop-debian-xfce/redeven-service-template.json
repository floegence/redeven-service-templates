{
  "schema_version": 4,
  "template_id": "linuxserver-webtop-debian-xfce",
  "service_family_id": "linuxserver-webtop-debian-xfce",
  "recommended_version": "debian-xfce-e67d68c1-ls220",
  "revision": 6,
  "sort_order": 40,
  "developer_preview": false,
  "disk_bytes": 6442450944,
  "source_url": "https://github.com/linuxserver/docker-webtop",
  "deployment": "container",
  "container_mode": "single",
  "default_access_mode": "unified_proxy",
  "platform_artifacts": {
    "linux-amd64": "lscr.io/linuxserver/webtop:debian-xfce-e67d68c1-ls220@sha256:eb818ac608fb56c003907528b637db394e69e9735edb1b42131902ad72a11e94",
    "linux-arm64": "lscr.io/linuxserver/webtop:debian-xfce-e67d68c1-ls220@sha256:e163f0b1601854257a257e12f831d2ed4df95463c6ea749c3d12ee3edb4a26ef"
  },
  "release_discovery": {
    "source": "oci"
  },
  "notices": [
    {
      "id": "interactive-desktop-root-and-network",
      "revision": 1,
      "severity": "warning",
      "acknowledgement_required": true
    }
  ],
  "icon": {
    "path": "assets/icon.svg",
    "media_type": "image/svg+xml"
  },
  "spec": {
    "schema_version": 7,
    "kind": "container",
    "endpoint": {
      "scheme": "http",
      "container_port": 3000,
      "path": "/",
      "health_path": "/",
      "startup_timeout_sec": 180
    },
    "container": {
      "image": "${REDEVEN_CATALOG_ARTIFACT}",
      "environment": {
        "PUID": "${REDEVEN_RUNTIME_UID}",
        "PGID": "${REDEVEN_RUNTIME_GID}",
        "TZ": "${REDEVEN_RUNTIME_TIMEZONE}",
        "TITLE": "Debian XFCE",
        "START_DOCKER": "false",
        "FILE_MANAGER_PATH": "/workspace",
        "SELKIES_USE_CPU": "true|locked",
        "SELKIES_ENABLE_SHARING": "false|locked",
        "SELKIES_ENABLE_COLLAB": "false|locked",
        "SELKIES_ENABLE_SHARED": "false|locked",
        "SELKIES_UI_SIDEBAR_SHOW_SHARING": "false|locked"
      },
      "mounts": [
        {
          "resource_id": "config",
          "type": "volume",
          "source": "config",
          "target": "/config"
        },
        {
          "resource_id": "workspace",
          "type": "workspace",
          "target": "/workspace"
        }
      ],
      "read_only_root": false,
      "pids_limit": 2048,
      "runtime_profile": "interactive_desktop"
    }
  },
  "kind": "redeven.service-template",
  "default_locale": "en-US",
  "locales": [
    "en-US",
    "zh-CN",
    "zh-TW",
    "ja-JP",
    "ko-KR",
    "de-DE",
    "fr-FR",
    "es-ES",
    "pt-BR",
    "ru-RU"
  ]
}
