{
  "schema_version": 3,
  "template_id": "deepseek-harness-host",
  "service_family_id": "deepseek-harness-host",
  "recommended_version": "0.1.5-rc.1",
  "revision": 9,
  "sort_order": 10,
  "developer_preview": true,
  "disk_bytes": 2147483648,
  "source_url": "https://github.com/deepseek-ai/deepseek-harness",
  "deployment": "host",
  "default_access_mode": "desktop_loopback",
  "supported_platforms": [
    "darwin-amd64",
    "darwin-arm64",
    "linux-amd64",
    "linux-arm64"
  ],
  "release_discovery": {
    "source": "npm"
  },
  "notices": [
    {
      "id": "service-api-credentials",
      "revision": 1,
      "severity": "info",
      "acknowledgement_required": false
    }
  ],
  "icon": {
    "path": "assets/icon.svg",
    "media_type": "image/svg+xml"
  },
  "spec": {
    "schema_version": 6,
    "kind": "host",
    "endpoint": {
      "scheme": "http",
      "path": "/",
      "health_path": "/",
      "startup_timeout_sec": 45
    },
    "host": {
      "output_mode": "private_file",
      "after_start_script": "umask 077\n[ ! -s \"$REDEVEN_SERVICE_RUN_DIR/open-url\" ] || exit 0\nwhile :; do\n  url=$(head -c 16777216 \"$REDEVEN_SERVICE_OUTPUT_FILE\" | awk 'index($0, \"dsh web: \") == 1 { print substr($0, 10); exit }')\n  if [ -n \"$url\" ]; then\n    printf '%s\\n' \"$url\" > \"$REDEVEN_SERVICE_RUN_DIR/open-url.tmp\"\n    mv \"$REDEVEN_SERVICE_RUN_DIR/open-url.tmp\" \"$REDEVEN_SERVICE_RUN_DIR/open-url\"\n    exit 0\n  fi\n  sleep 0.1\ndone",
      "open_script": "cat \"$REDEVEN_SERVICE_RUN_DIR/open-url\"",
      "start_script": "exec \"$REDEVEN_INSTALL_EXECUTABLE\" web --host \"$REDEVEN_SERVICE_HOST\" --port \"$REDEVEN_SERVICE_PORT\" --no-open",
      "environment": {
        "DSH_DESKTOP_ENABLED": "0",
        "DSH_HOME": "${REDEVEN_SERVICE_DATA_DIR}",
        "HOME": "${REDEVEN_WORKSPACE}"
      },
      "npm": {
        "package_name": "@deepseek-ai/dsh",
        "version": "0.1.5-rc.1",
        "registry_url": "https://registry.npmjs.org/",
        "executable": "dsh"
      }
    }
  },
  "kind": "redeven.service-template",
  "default_locale": "en-US",
  "locales": [
    "en-US",
    "zh-CN",
    "zh-TW",
    "ja-JP",
    "ko-KR",
    "de-DE",
    "fr-FR",
    "es-ES",
    "pt-BR",
    "ru-RU"
  ]
}
